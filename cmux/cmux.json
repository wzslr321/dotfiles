{
  "$schema": "https://raw.githubusercontent.com/manaflow-ai/cmux/main/web/data/cmux.schema.json",
  "schemaVersion": 1,

  "paneBorderColor": "#565f89",
  "activePaneBorderColor": "#7aa2f7",

  "app": {
    "appearance": "dark",
    "newWorkspacePlacement": "afterCurrent",
    "workspaceInheritWorkingDirectory": true
  },

  "terminal": {
    "showScrollBar": false,
    "copyOnSelect": false,
    "autoResumeAgentSessions": true
  },

  "sidebarAppearance": {
    "matchTerminalBackground": true
  },

  "shortcuts": {
    "bindings": {
      "splitRight": ["cmd+d", "ctrl+d", "alt+n"],
      "focusLeft": ["cmd+opt+←", "alt+h"],
      "focusDown": ["cmd+opt+↓", "alt+j"],
      "focusUp": ["cmd+opt+↑", "alt+k"],
      "focusRight": ["cmd+opt+→", "alt+l"],
      "closeTab": ["cmd+w", "ctrl+z"]
    }
  }
}
